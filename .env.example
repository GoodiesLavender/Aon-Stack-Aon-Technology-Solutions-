# ---------------------------------------------------------------------------
# Aon Technology Solutions LLC — environment variables (PLACEHOLDERS ONLY)
# Copy values into the platform Secrets / local .env. Never commit real secrets.
# This is a Vite app — do NOT use NEXT_PUBLIC_ prefixes for privileged keys.
# ---------------------------------------------------------------------------

# Stripe Live
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Supabase (server-side only — used by api/* via service role)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# Resend (customer + sales emails)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Aon Technology Solutions LLC <hello@your-verified-domain.com>

# Optional session secret if OAuth/admin cookie auth is added later
# SESSION_SECRET=
